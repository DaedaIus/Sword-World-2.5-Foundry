<form class="{{cssClass}} sw25-monster-sheet" autocomplete="off">
  <header class="monster-header">
    <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div><input class="monster-name" name="name" value="{{actor.name}}"><div class="monster-subtitle">Level <input type="number" name="system.level" value="{{system.level}}"> <input name="system.monsterType" value="{{system.monsterType}}" placeholder="Monster type"></div></div>
    {{#if isGM}}<div class="monster-gm-actions"><button type="button" data-action="import-monster"><i class="fas fa-file-import"></i> Import</button><button type="button" class="reveal-monster {{#if system.revealed}}active{{/if}}" data-action="toggle-monster-reveal"><i class="fas {{#if system.revealed}}fa-eye-slash{{else}}fa-eye{{/if}}"></i> {{#if system.revealed}}Hide from Players{{else}}Reveal to Players{{/if}}</button></div>{{/if}}
  </header>
  {{#if canRead}}
  <div class="monster-sheet-body">
    <section class="monster-grid monster-overview">
      <label>Intelligence<input name="system.intelligence" value="{{system.intelligence}}"></label><label>Perception<input name="system.perception" value="{{system.perception}}"></label><label>Disposition<input name="system.disposition" value="{{system.disposition}}"></label><label>Soulscars<input type="number" name="system.soulscars" value="{{system.soulscars}}"></label>
      <label>Languages<input name="system.languages" value="{{system.languages}}"></label><label>Habitat<input name="system.habitat" value="{{system.habitat}}"></label><label>Reputation<input type="number" name="system.reputation" value="{{system.reputation}}"></label><label>Weakness<input type="number" name="system.weakness" value="{{system.weakness}}"></label>
      <label class="wide">Weak Point<input name="system.weakPoint" value="{{system.weakPoint}}"></label><label>Initiative<span class="monster-initiative-control"><input type="number" name="system.initiative" value="{{system.initiative}}">{{#if isGM}}<button type="button" data-action="roll-monster-initiative" title="Roll side initiative"><i class="fas fa-dice-d6"></i></button>{{/if}}</span></label><label>Movement<input name="system.movementSpeed" value="{{system.movementSpeed}}"></label><label>Fortitude<input name="system.fortitude" value="{{system.fortitude}}"></label><label>Willpower<input name="system.willpower" value="{{system.willpower}}"></label>
    </section>

    <section class="monster-panel"><h2>Combat Statistics {{#if isGM}}<button type="button" data-action="add-monster-style"><i class="fas fa-plus"></i></button>{{/if}}</h2>
      <div class="monster-combat-head"><span>Style / Section</span><span>Accuracy</span><span>Damage</span><span>Evasion</span><span>Defense</span><span>HP</span><span>MP</span><span></span></div>
      {{#each combatStyles as |style|}}<div class="monster-combat-row">
        <input name="system.combatStyles.{{style.index}}.style" value="{{style.style}}"><span class="rollable-stat"><button type="button" data-action="roll-monster-accuracy" data-index="{{style.index}}"><i class="fas fa-dice-d6"></i></button><input name="system.combatStyles.{{style.index}}.accuracy" value="{{style.accuracy}}" title="Accuracy modifier"></span>
        <span class="rollable-stat"><button type="button" data-action="roll-monster-damage" data-index="{{style.index}}"><i class="fas fa-dice-d6"></i></button><input name="system.combatStyles.{{style.index}}.damage" value="{{style.damage}}" title="Damage formula"></span>
        <input name="system.combatStyles.{{style.index}}.evasion" value="{{style.evasion}}"><input type="number" name="system.combatStyles.{{style.index}}.defense" value="{{style.defense}}"><span class="paired"><input type="number" name="system.combatStyles.{{style.index}}.hp.value" value="{{style.hp.value}}">/<input type="number" name="system.combatStyles.{{style.index}}.hp.max" value="{{style.hp.max}}"></span><span class="paired"><input type="number" name="system.combatStyles.{{style.index}}.mp.value" value="{{style.mp.value}}">/<input type="number" name="system.combatStyles.{{style.index}}.mp.max" value="{{style.mp.max}}"></span>{{#if ../isGM}}<button type="button" data-action="delete-monster-style" data-index="{{style.index}}"><i class="fas fa-trash"></i></button>{{/if}}
      </div>{{/each}}
    </section>

    <section class="monster-panel"><h2>Unique Skills {{#if isGM}}<button type="button" data-action="add-monster-skill"><i class="fas fa-plus"></i></button>{{/if}}</h2>{{#each uniqueSkills as |skill|}}<article class="monster-ability"><input name="system.uniqueSkills.{{skill.index}}.title" value="{{skill.title}}"><textarea name="system.uniqueSkills.{{skill.index}}.description">{{skill.description}}</textarea>{{#if ../isGM}}<button type="button" data-action="delete-monster-skill" data-index="{{skill.index}}"><i class="fas fa-trash"></i></button>{{/if}}</article>{{/each}}</section>

    <section class="monster-panel monster-loot"><h2>Loot Table <button type="button" data-action="roll-monster-loot"><i class="fas fa-dice-d6"></i> Roll Loot</button>{{#if isGM}}<button type="button" data-action="add-monster-loot"><i class="fas fa-plus"></i></button>{{/if}}</h2>{{#each lootTable as |entry|}}<div><input name="system.lootTable.{{entry.index}}.roll" value="{{entry.roll}}"><input name="system.lootTable.{{entry.index}}.loot" value="{{entry.loot}}">{{#if ../isGM}}<button type="button" data-action="delete-monster-loot" data-index="{{entry.index}}"><i class="fas fa-trash"></i></button>{{/if}}</div>{{/each}}</section>
    <section class="monster-panel"><h2>Description</h2><textarea class="monster-description" name="system.description">{{system.description}}</textarea><label>Source <input name="system.source" value="{{system.source}}"></label><label>Source URL <input name="system.sourceUrl" value="{{system.sourceUrl}}"></label></section>
  </div>
  {{else}}<div class="monster-hidden"><i class="fas fa-eye-slash"></i><p>This monster has not been revealed.</p></div>{{/if}}
</form>
